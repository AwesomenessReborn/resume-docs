{
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build/work",
  "latex-workshop.latex.recipe.default": "latexmk (repository)",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (repository)",
      "tools": [
        "latexmk-repository"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-repository",
      "command": "latexmk",
      "args": [
        "-r",
        "%WORKSPACE_FOLDER%/.latexmkrc",
        "-pdf",
        "-outdir=%OUTDIR%",
        "-auxdir=%OUTDIR%",
        "%DOC%"
      ],
      "env": {
        "TEXINPUTS": "..:"
      }
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab"
}